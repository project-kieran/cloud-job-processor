import { JobQueue } from "../types/job";
import { SQSClient, SendMessageCommand, ReceiveMessageCommand, SQS } from "@aws-sdk/client-sqs";


export class SqsJobQueue implements JobQueue {
    constructor(
        private jobs: string[] = [],
        private readonly client: SQSClient,
        private readonly queueUrl: string
    ) {}
    async enqueue(jobId: string): Promise<void> {
        await this.client.send(
            new SendMessageCommand({
                QueueUrl: this.queueUrl,
                MessageBody: jobId
            }),
        );
    }

    async dequeue(): Promise<string | undefined> {
        const response = await this.client.send(
            new ReceiveMessageCommand({
                QueueUrl: this.queueUrl,
                MaxNumberOfMessages: 1,
                WaitTimeSeconds: 20
            }),
        );
        return response.Messages?.[0]?.Body;
    }
}